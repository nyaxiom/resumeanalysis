# Shell-compatible environment variables. Copy to .env; do not commit .env.
RESUMEANALYSIS_DATABASE_PATH=data/ml-service.sqlite3
# Set empty to disable the E5 embedding cache.
RESUMEANALYSIS_EMBEDDING_CACHE_DIR=artifacts/service-embeddings
RESUMEANALYSIS_E5_MODEL=intfloat/multilingual-e5-small
RESUMEANALYSIS_E5_REVISION=614241f622f53c4eeff9890bdc4f31cfecc418b3
RESUMEANALYSIS_E5_LOCAL_PATH=
RESUMEANALYSIS_E5_DEVICE=cpu
RESUMEANALYSIS_E5_BATCH_SIZE=16
RESUMEANALYSIS_E5_MAX_LENGTH=512
RESUMEANALYSIS_E5_OVERLAP=32
RESUMEANALYSIS_LEARNING_RATE=0.05
RESUMEANALYSIS_L2=0.001
RESUMEANALYSIS_QWEN_MODEL=Qwen/Qwen3-4B-Instruct-2507
RESUMEANALYSIS_QWEN_REVISION=cdbee75f17c01a7cc42f958dc650907174af0554
RESUMEANALYSIS_QWEN_LOCAL_PATH=
RESUMEANALYSIS_QWEN_DEVICE=cpu
RESUMEANALYSIS_QWEN_DTYPE=float32
RESUMEANALYSIS_QWEN_MAX_INPUT_TOKENS=4096
RESUMEANALYSIS_QWEN_MAX_NEW_TOKENS=512
RESUMEANALYSIS_LETTER_MAX_WORDS=180
