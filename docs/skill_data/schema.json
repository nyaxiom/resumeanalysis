{
  "$defs": {
    "Annotation": {
      "additionalProperties": false,
      "properties": {
        "category": {
          "title": "Category",
          "type": "string"
        },
        "surface": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Surface"
        },
        "start": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Start"
        },
        "end": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "End"
        },
        "skill_label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Skill Label"
        },
        "skill_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Skill Id"
        },
        "attributes": {
          "additionalProperties": true,
          "title": "Attributes",
          "type": "object"
        }
      },
      "required": [
        "category"
      ],
      "title": "Annotation",
      "type": "object"
    },
    "Provenance": {
      "additionalProperties": false,
      "properties": {
        "dataset": {
          "title": "Dataset",
          "type": "string"
        },
        "repository": {
          "title": "Repository",
          "type": "string"
        },
        "revision": {
          "title": "Revision",
          "type": "string"
        },
        "source_file": {
          "title": "Source File",
          "type": "string"
        },
        "source_sha256": {
          "title": "Source Sha256",
          "type": "string"
        },
        "source_rows": {
          "items": {
            "type": "integer"
          },
          "title": "Source Rows",
          "type": "array"
        },
        "split": {
          "title": "Split",
          "type": "string"
        },
        "role": {
          "enum": [
            "train",
            "validation",
            "external_evaluation",
            "auxiliary",
            "research_only"
          ],
          "title": "Role",
          "type": "string"
        },
        "license": {
          "title": "License",
          "type": "string"
        },
        "license_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "License Url"
        },
        "license_evidence_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "License Evidence Url"
        },
        "attribution": {
          "title": "Attribution",
          "type": "string"
        },
        "group_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Group Id"
        }
      },
      "required": [
        "dataset",
        "repository",
        "revision",
        "source_file",
        "source_sha256",
        "source_rows",
        "split",
        "role",
        "license",
        "attribution"
      ],
      "title": "Provenance",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "id": {
      "title": "Id",
      "type": "string"
    },
    "text": {
      "title": "Text",
      "type": "string"
    },
    "text_origin": {
      "enum": [
        "source",
        "space_joined_tokens"
      ],
      "title": "Text Origin",
      "type": "string"
    },
    "language": {
      "title": "Language",
      "type": "string"
    },
    "annotation_type": {
      "enum": [
        "span",
        "surface_normalization",
        "sentence_multilabel",
        "title_multilabel"
      ],
      "title": "Annotation Type",
      "type": "string"
    },
    "annotations": {
      "items": {
        "$ref": "#/$defs/Annotation"
      },
      "title": "Annotations",
      "type": "array"
    },
    "tokens": {
      "anyOf": [
        {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Tokens"
    },
    "provenance": {
      "$ref": "#/$defs/Provenance"
    },
    "source_records": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "title": "Source Records",
      "type": "array"
    }
  },
  "required": [
    "id",
    "text",
    "text_origin",
    "language",
    "annotation_type",
    "annotations",
    "provenance",
    "source_records"
  ],
  "title": "SkillRecord",
  "type": "object"
}
